coverage/

# Native build output. Regenerated by `npx cap sync` and gradle; the copied
# web assets go stale the moment the app is rebuilt.
android/app/build/
android/.gradle/
android/app/src/main/assets/public/
android/local.properties
android/app/release/
ios/App/Pods/
ios/App/App/public/
ios/DerivedData/

# Built app packages, delivered rather than committed.
*.apk
*.aab
*.ipa

# Hosting
.vercel/

*.local
*.log
.DS_Store
