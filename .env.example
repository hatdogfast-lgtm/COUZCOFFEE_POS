# Central sync server. Never commit real secrets - copy to .env and fill in.
POS_SERVER_PORT=4000
POS_DATA_DIR=./data
POS_JWT_SECRET=change-me-to-a-long-random-string
# Exact-match allowlist, comma separated. Include https://localhost when an
# Android APK syncs to this server - that is the origin Capacitor gives it,
# and leaving it out blocks the app while the website keeps working.
POS_ALLOW_ORIGIN=http://localhost:5174,https://localhost

# Typed once per device under "Join an existing one". Required in production.
POS_ENROLMENT_CODE=change-me-to-something-long
